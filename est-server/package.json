{
    "name": "de.tu-berlin.qu.effectstreamer.server",
    "displayName": "EffectStreamer",
    "version": "1.0.0",
    "description": "Research toolkit for reproducible ITU-T P.804 speech-quality experiments (Server)",
    "main": "./src/index.js",
    "author": "Eero Kaan",
    "company": "Quality and Usability Lab | TU Berlin",
    "scripts": {
        "test": "node ../est-common/run-tool.cjs est-server node --test test/*.test.js",
        "dev:format": "prettier --write .",
        "dev:lint": "node ../est-common/run-tool.cjs est-server eslint --cache --fix .",
        "dev:run": "EST_SERVER_TYPE=harness node ../est-common/run-tool.cjs est-server node ./src/index.js",
        "build:linux": "TARGET_OS=linux bash ./build_scripts/build.sh",
        "build:win": "TARGET_OS=win bash ./build_scripts/build.sh"
    },
    "dependencies": {
        "@effectstreamer/common": "file:../est-common",
        "express": "^5.2.1",
        "jose": "^6.2.14",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.1.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@vercel/ncc": "^0.38.4",
        "eslint": "^9.39.1",
        "postject": "^1.0.0-alpha.6",
        "prettier": "^3.8.1",
        "prettier-plugin-brace-style": "^0.9.0",
        "prettier-plugin-merge": "^0.9.1",
        "socket.io-client": "^4.8.4"
    }
}
