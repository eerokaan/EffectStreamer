    "pretestForm": [
        {
            "name": "input-age",
            "type": "input",
            "inputType": "number",
            "label": "Age",
            "description": "How old are you?",
            "placeholder": "Please specify",
            "required": true,
            "layoutWidth": 6,
            "validation": { "valueType": "integer", "min": 0 }
        },
        {
            "name": "select-gender",
            "type": "select",
            "label": "Gender",
            "description": "How do you identify?",
            "placeholder": "Please specify",
            "required": true,
            "layoutWidth": 6,
            "options": [
                { "value": "female", "label": "Female" },
                { "value": "male", "label": "Male" },
                { "value": "non-binary", "label": "Non-binary" },
                { "value": "other", "label": "Other" },
                { "value": "no-choice", "label": "Prefer not to say" }
            ]
        },
        {
            "name": "select-german-proficiency",
            "type": "select",
            "label": "German proficiency",
            "description": "How would you rate your German proficiency?",
            "placeholder": "Please specify",
            "required": true,
            "layoutWidth": 12,
            "options": [
                { "value": "native", "label": "Native speaker" },
                { "value": "level-c", "label": "C1–C2 (Professional proficiency)" },
                { "value": "level-b", "label": "B1–B2 (Conversational)" },
                { "value": "level-a", "label": "A1–A2 (Beginner)" },
                { "value": "other", "label": "None of the above" }
            ]
        },
        {
            "name": "select-hours-internet",
            "type": "select",
            "label": "Hours online per week",
            "description": "On average, how many hours do you spend online per week?",
            "placeholder": "Please specify",
            "required": true,
            "layoutWidth": 6,
            "options": [
                { "value": "less-than-3h", "label": "< 3 h/week (~ 25 min/day)" },
                { "value": "between-3h-6h", "label": "3–6 h/week (~ 25–50 min/day)" },
                { "value": "between-6h-9h", "label": "6–9 h/week (~ 1 h/day)" },
                { "value": "between-9h-15h", "label": "9–15 h/week (~ 1–2 h/day)" },
                { "value": "between-15h-21h", "label": "15–21 h/week (~ 2–3 h/day)" },
                { "value": "between-21h-30h", "label": "21–30 h/week (~ 3–4 h/day)" },
                { "value": "between-30h-40h", "label": "30–40 h/week (~ 4–6 h/day)" },
                { "value": "between-40h-60h", "label": "40–60 h/week (~ 6–8 h/day)" },
                { "value": "more-than-60h", "label": "> 60 h/week (~ 8 h/day)" }
            ]
        },
        {
            "name": "select-hours-calls",
            "type": "select",
            "label": "Hours on voice or video calls per week",
            "description": "On average, how many hours per week do you spend on internet calls (e.g. via Discord, Zoom or WhatsApp)?",
            "placeholder": "Please specify",
            "required": true,
            "layoutWidth": 6,
            "options": [
                { "value": "less-than-3h", "label": "< 3 h/week (~ 25 min/day)" },
                { "value": "between-3h-6h", "label": "3–6 h/week (~ 25–50 min/day)" },
                { "value": "between-6h-9h", "label": "6–9 h/week (~ 1 h/day)" },
                { "value": "between-9h-15h", "label": "9–15 h/week (~ 1–2 h/day)" },
                { "value": "between-15h-21h", "label": "15–21 h/week (~ 2–3 h/day)" },
                { "value": "between-21h-30h", "label": "21–30 h/week (~ 3–4 h/day)" },
                { "value": "between-30h-40h", "label": "30–40 h/week (~ 4–6 h/day)" },
                { "value": "between-40h-60h", "label": "40–60 h/week (~ 6–8 h/day)" },
                { "value": "more-than-60h", "label": "> 60 h/week (~ 8 h/day)" }
            ]
        },
        {
            "name": "slider-experience",
            "type": "slider",
            "label": "Previous experience with voice or video calls",
            "required": false,
            "layoutWidth": 12,
            "validation": { "min": 0, "max": 100, "step": 1 },
            "defaultValue": 50,
            "marks": { "minLabel": "Not experienced", "maxLabel": "Very experienced" }
        },
        {
            "name": "switch-gaming",
            "type": "switch",
            "label": "Do you play video games with voice chat?",
            "description": "For example, via Discord or TeamSpeak.",
            "required": false,
            "layoutWidth": 6,
            "defaultValue": false
        },
        {
            "name": "switch-streaming",
            "type": "switch",
            "label": "Do you livestream your gameplay?",
            "description": "For example, on Twitch or YouTube.",
            "required": false,
            "layoutWidth": 6,
            "defaultValue": false
        },
        {
            "name": "switch-prior-experience",
            "type": "switch",
            "label": "Any previous experience?",
            "description": "Have you ever taken part in a listening test or experiment?",
            "required": false,
            "layoutWidth": 6,
            "defaultValue": false
        },
        {
            "name": "switch-audio-tech-familiarity",
            "type": "switch",
            "label": "Familiar with audio technology?",
            "description": "Do you regularly work with audio technology methods or research, for example as part of your job?",
            "required": false,
            "layoutWidth": 6,
            "defaultValue": false
        }
    ]
}
