{
    "name": "de.tu-berlin.qu.echostreamer.gui",
    "displayName": "EchoStreamer",
    "version": "1.0.0",
    "description": "A tool to research the effects of echo in a voice call",
    "main": "./out/main/index.js",
    "author": "Eero Kaan",
    "company": "Quality and Usability Lab / TU Berlin",
    "scripts": {
        "dev:format": "prettier --write .",
        "dev:lint": "eslint --cache --fix .",
        "dev:run": "electron-vite dev -- --no-sandbox",
        "dev:preview": "electron-vite preview -- --no-sandbox",
        "dev:build": "electron-vite build",
        "build:unpack": "npm run dev:build && electron-builder --dir",
        "build:win": "npm run dev:build && electron-builder --win",
        "build:mac": "npm run dev:build && electron-builder --mac",
        "build:linux": "npm run dev:build && electron-builder --linux",
        "postinstall": "electron-builder install-app-deps"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@tailwindcss/vite": "^4.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.575.0",
        "radix-ui": "^1.4.3",
        "shadcn": "^3.8.5",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.1.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@vitejs/plugin-react": "^5.1.1",
        "electron": "^39.2.6",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "prettier": "^3.8.1",
        "prettier-plugin-brace-style": "^0.9.0",
        "prettier-plugin-merge": "^0.9.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "vite": "^7.2.6"
    }
}
